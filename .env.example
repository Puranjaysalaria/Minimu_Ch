# Minimi Environment Variables
PORT=3000
NODE_ENV=development

# Google Gemini API Configuration
# Obtain your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Tavily Web Search API Configuration
# Obtain your key at: https://tavily.com
TAVILY_API_KEY=

# Database configuration
DATABASE_PATH=./data/minimi.db

# Application Timezone (IANA Timezone Name)
APP_TIMEZONE=Asia/Kolkata

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173
